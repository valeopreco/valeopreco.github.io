# Copie para .env.local (nunca faça commit do .env.local).

# Domínio público, sem barra no fim. Ativa canonical, og:url e sitemap.xml.
# Deixe vazio enquanto não houver domínio definitivo.
VITE_SITE_URL=

# Supabase (opcional). Sem estas duas, o app funciona só no aparelho e a seção "Conta" não aparece.
# Use SOMENTE a chave "anon public". NUNCA coloque a service_role key aqui: tudo que começa com VITE_ vai para o navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Só para prévias em hospedagem sem reescrita de rotas (ex.: GitHub Pages).
VITE_HASH_ROUTER=false
